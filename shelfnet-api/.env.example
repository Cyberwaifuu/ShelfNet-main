# MongoDB connection string used by spring.data.mongodb.uri
MONGODB_URI=mongodb://root:secret@localhost:27017/shelfnet?authSource=admin

# Secret used to sign JWT tokens. Must be long enough for HS256 (>= 32 chars).
# Generate one with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars-long
